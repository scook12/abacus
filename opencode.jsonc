{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "explore": {
      "description": "Read-only exploration agent for codebase research and discovery.",
      "mode": "primary",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "deny",
        "bash": "deny",
        "webfetch": "ask"
      }
    }
  },
  "plugin": [
   [
       "./.opencode/plugins/abacus.ts",
       {
         "mode": "enforce-full",
         "askBehavior": "allow-log",
         "configPath": "./abacus.toml"
       }
     ]
   ]
}
