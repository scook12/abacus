{
  "name": "abacus-workspace",
  "private": true,
  "packageManager": "pnpm@10.7.1",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "clean": "pnpm -r --if-present run clean",
    "test": "pnpm -r --if-present run test",
    "test:integration": "pnpm -r --if-present run test:integration",
    "test:rego": "pnpm -r --if-present run test:rego",
    "typecheck": "pnpm -r --if-present run typecheck",
    "changeset": "changeset",
    "release:status": "changeset status",
    "release:checklist": "node -e \"console.log('Follow docs/release-checklist.md')\"",
    "release:version": "changeset version",
    "release:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.6"
  }
}
